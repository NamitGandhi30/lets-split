// Cloudflare Worker that only serves the built PWA (static assets, no server code).
// Build: `pnpm build` -> apps/web/dist. Deploy: `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lets-split",
  "compatibility_date": "2026-11-01",
  // Serve on lets-split.<account>.workers.dev, and give each preview build its own URL.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./apps/web/dist",
    // Unknown paths like /stats get index.html so React Router can handle them.
    "not_found_handling": "single-page-application"
  }
}
